<Application x:Class="ClipDropPro.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClipDropPro"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="AppBackground" Color="#A00B0B10" />
            <SolidColorBrush x:Key="TextColor" Color="#FFFFFF" />
            <SolidColorBrush x:Key="IconColor" Color="#C0C0C0" />
            <SolidColorBrush x:Key="CardBg" Color="#77222828" />
            <SolidColorBrush x:Key="WindowBg" Color="#1C1C1C" />
            <SolidColorBrush x:Key="ControlBg" Color="#AA333338" />
            <SolidColorBrush x:Key="BorderColor" Color="#553D3D3D" />
            <SolidColorBrush x:Key="AccentColor" Color="#60CDFF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
