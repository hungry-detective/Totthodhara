<Window x:Class="ClipDropPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:conv="clr-namespace:ClipDropPro.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Totthodhara" Height="36" Width="800"
        x:Name="RootWindow"
        Icon="app.png"
        WindowStyle="None" Background="Transparent"
        BorderThickness="0" BorderBrush="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        AllowDrop="True" Drop="Window_Drop" PreviewDragOver="Window_PreviewDragOver"
        PreviewMouseDown="Window_PreviewMouseDown" PreviewMouseUp="Window_PreviewMouseUp" ShowInTaskbar="False"
        WindowStartupLocation="Manual">


    <Window.Resources>
        <sys:Double x:Key="ItemMenuHeight">36</sys:Double>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVis" />
        <conv:FileToSymbolConverter x:Key="FileToSymbolConverter" />
        <conv:PinnedToColorConverter x:Key="PinnedToColorConverter" />
        <conv:PinnedToMenuItemConverter x:Key="PinnedToMenuItemConverter" />
        <conv:SnippetToMenuItemConverter x:Key="SnippetToMenuItemConverter" />
        <conv:StringToHorizontalAlignmentConverter x:Key="StringToAddConverter" />

        <!-- Shared ContextMenu Style for Tray (no DynamicResource - separate visual tree) -->
        <Style x:Key="ModernContextMenu" TargetType="ContextMenu">
            <EventSetter Event="Opened" Handler="ContextMenu_Opened"/>
            <EventSetter Event="Closed" Handler="ContextMenu_Closed"/>
            <Setter Property="Background" Value="{DynamicResource MenuBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MenuItem Style (no DynamicResource - safe for isolated visual trees like tray ContextMenu) -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid MinHeight="{DynamicResource ItemMenuHeight}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="HoverBorder" Grid.ColumnSpan="2" Background="Transparent" CornerRadius="4" Margin="4,2"/>
                            <ContentPresenter ContentSource="Icon" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0"/>
                            <ContentPresenter ContentSource="Header" Grid.Column="1" Margin="12,6" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverBorder" Property="Background" Value="{DynamicResource ControlBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource AppBackground}" PreviewMouseLeftButtonDown="RootGrid_PreviewMouseLeftButtonDown">
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="Totthodhara is running"
                        MenuActivation="RightClick"
                        TrayMouseDoubleClick="TaskbarIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Style="{StaticResource ModernContextMenu}">
                    <MenuItem Header="Show Shelf" Click="TaskbarIcon_TrayMouseDoubleClick" />
                    <Separator>
                        <Separator.Template>
                            <ControlTemplate TargetType="Separator">
                                <Border Height="1" Background="{DynamicResource BorderColor}" Margin="8,4" />
                            </ControlTemplate>
                        </Separator.Template>
                    </Separator>
                    <MenuItem Header="Exit" Click="ExitApp_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Border CornerRadius="0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Scroll Left -->
                    <ColumnDefinition Width="*"/>    <!-- Middle ScrollArea -->
                    <ColumnDefinition Width="Auto"/> <!-- Scroll Right -->
                    <ColumnDefinition Width="Auto"/> <!-- Search Button -->
                    <ColumnDefinition Width="Auto"/> <!-- MultiPaste Toggle -->
                    <ColumnDefinition Width="Auto"/> <!-- PasteAll Button -->
                    <ColumnDefinition Width="Auto"/> <!-- More Button -->
                </Grid.ColumnDefinitions>

                <!-- Scroll Left Button -->
                <Button Grid.Column="0" Click="ScrollLeft_Click" 
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextColor}" 
                        Margin="6,0,8,0" VerticalAlignment="Center" Width="{DynamicResource ItemCircleSize}" Height="{DynamicResource ItemCircleSize}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <!-- Modern circular background with subtle glass effect -->
                                            <Ellipse x:Name="background" 
                                                     Fill="{DynamicResource CardBg}" 
                                                     Stroke="{DynamicResource BorderColor}" 
                                                     StrokeThickness="1" 
                                                     Opacity="0.6"/>
                                            <ui:SymbolIcon Symbol="ChevronLeft24" 
                                                           FontSize="16"
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center" 
                                                           Foreground="{TemplateBinding Foreground}"
                                                           Margin="0,0,0,0"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="background" Property="Stroke" Value="{DynamicResource AccentColor}"/>
                                                <Setter TargetName="background" Property="Fill" Value="{DynamicResource ControlBg}"/>
                                                <Setter TargetName="background" Property="StrokeThickness" Value="1.5"/>
                                                <Setter TargetName="background" Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>


                <!-- Middle: Horizontal ScrollViewer + ItemsControl -->
                <Border Grid.Column="1" Margin="4,0">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0.0" />
                            <GradientStop Color="Black" Offset="0.01" /> 
                            <GradientStop Color="Black" Offset="0.99" />
                            <GradientStop Color="Transparent" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                    <ScrollViewer x:Name="ShelfScrollViewer"
                              HorizontalScrollBarVisibility="Hidden" 
                              VerticalScrollBarVisibility="Disabled"
                              PanningMode="HorizontalOnly"
                              HorizontalAlignment="{Binding Alignment, Converter={StaticResource StringToAddConverter}}"
                              PreviewMouseWheel="ShelfScrollViewer_PreviewMouseWheel">
                    <ItemsControl x:Name="ItemsHost"
                                  ItemsSource="{Binding ClipboardItems}"
                                  VerticalAlignment="Center"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.ScrollUnit="Item">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal" IsVirtualizing="True" VirtualizationMode="Recycling"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="{DynamicResource ItemMargin}" CornerRadius="10" Padding="{DynamicResource ItemPadding}" SnapsToDevicePixels="True"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource CardBg}"/>
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                            </Trigger>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="0.9" To="1" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" From="0.9" To="1" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <DataTrigger Binding="{Binding IsRemoving}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="0" Duration="0:0:0.3">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseIn"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="0" Duration="0:0:0.3">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseIn"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                                                <Setter Property="Opacity" Value="0.85"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.ContextMenu>
                                    <ContextMenu Style="{StaticResource ModernContextMenu}" StaysOpen="False" Placement="Bottom" VerticalOffset="6">
                                        <MenuItem Header="{Binding IsPinned, Converter={StaticResource PinnedToMenuItemConverter}}"
                                                  Command="{Binding PlacementTarget.Tag.TogglePinCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Pin24" FontSize="12" Foreground="{DynamicResource TextColor}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{Binding IsSnippet, Converter={StaticResource SnippetToMenuItemConverter}}"
                                                  Command="{Binding PlacementTarget.Tag.ToggleSnippetCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Star24" FontSize="12" Foreground="{DynamicResource TextColor}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Delete"
                                                  Command="{Binding PlacementTarget.Tag.DeleteItemCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="12" Foreground="{DynamicResource TextColor}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                
                                <Grid PreviewMouseMove="Item_PreviewMouseMove" ToolTipService.InitialShowDelay="100" ToolTipService.ShowDuration="15000" ToolTipService.ShowOnDisabled="False">
                                    <Grid.ToolTip>
                                        <ToolTip Background="{DynamicResource ToolTipBg}" BorderBrush="{DynamicResource BorderColor}" Padding="5" Placement="Top" VerticalOffset="-8">
                                            <StackPanel MaxWidth="300">
                                                <!-- Image ToolTip -->
                                                <Image Source="{Binding ThumbnailSource}" MaxHeight="200" Stretch="Uniform" 
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}"/>
                                                
                                                <!-- Video ToolTip with Play Overlay -->
                                                <Grid Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}" MaxHeight="200">
                                                    <Image Source="{Binding ThumbnailSource}" Stretch="Uniform" 
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <Path Data="M 0,0 L 20,10 L 0,20 Z" Fill="#CCFFFFFF" Stretch="Uniform" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>

                                                <!-- PDF Info Card -->
                                                <StackPanel Visibility="{Binding IsPdf, Converter={StaticResource BoolToVis}}" MinWidth="200" Margin="10">
                                                    <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="{DynamicResource IconColor}"/>
                                                    <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextColor}" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                                    <TextBlock Text="PDF Document" Foreground="{DynamicResource TextColor}" Opacity="0.6" FontSize="10" HorizontalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Audio Info Card -->
                                                <StackPanel Visibility="{Binding IsAudio, Converter={StaticResource BoolToVis}}" MinWidth="200" Margin="10">
                                                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="{DynamicResource IconColor}"/>
                                                    <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextColor}" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                                    <TextBlock Text="Audio File" Foreground="{DynamicResource TextColor}" Opacity="0.6" FontSize="10" HorizontalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Text ToolTip -->
                                                <TextBlock Text="{Binding TextContent}" Foreground="{DynamicResource TextColor}" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </ToolTip>
                                    </Grid.ToolTip>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- Column 0: Pill index -->
                                        <ColumnDefinition Width="Auto"/> <!-- Column 1: Icon -->
                                        <ColumnDefinition Width="*"/>    <!-- Column 2: Content -->
                                        <ColumnDefinition Width="Auto"/> <!-- Column 3: URL Open -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Pill index (Perfect Circle) + Pin/Snippet Overlays -->
                                    <Border Grid.Column="0" Width="{DynamicResource ItemCircleSize}" Height="{DynamicResource ItemCircleSize}" CornerRadius="{DynamicResource ItemCircleCorner}" Margin="0,0,4,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=1}}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                                           Foreground="{TemplateBinding Foreground}"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="background" Property="Stroke" Value="{DynamicResource AccentColor}"/>
                                                <Setter TargetName="background" Property="Fill" Value="{DynamicResource AccentColor}"/>
                                                <Setter TargetName="background" Property="StrokeThickness" Value="1.5"/>
                                                <Setter TargetName="background" Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsChecked" Value="False"/>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="background" Property="Stroke" Value="{DynamicResource AccentColor}"/>
                                                <Setter TargetName="background" Property="Fill" Value="{DynamicResource ControlBg}"/>
                                                <Setter TargetName="background" Property="StrokeThickness" Value="1.5"/>
                                                <Setter TargetName="background" Property="Opacity" Value="0.9"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <!-- Paste All Button (visible when items selected for multi-paste) -->
                <Button Grid.Column="5" x:Name="PasteAllButton"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextColor}"
                        Margin="2,0" VerticalAlignment="Center" Padding="6,0"
                        Click="PasteAllButton_Click"
                        FocusVisualStyle="{x:Null}"
                        ToolTip="Paste all selected items">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedItems}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Border CornerRadius="4" Background="{DynamicResource AccentColor}" Padding="6,2">
                        <TextBlock Text="Paste All" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </Button>

                <!-- Right: More Button with Context Menu -->
                <Button Grid.Column="6"
                        x:Name="MoreButton"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource TextColor}"
                        Margin="4,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Width="{DynamicResource ItemCircleSize}" Height="{DynamicResource ItemCircleSize}"
                                        Click="MoreButton_Click"
                        FocusVisualStyle="{x:Null}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse x:Name="background" 
                                                     Fill="{DynamicResource CardBg}" 
                                                     Stroke="{DynamicResource BorderColor}" 
                                                     StrokeThickness="1" 
                                                     Opacity="0.6"/>
                                            <ui:SymbolIcon Symbol="MoreHorizontal24" 
                                                           FontSize="16"
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center" 
                                                           Foreground="{TemplateBinding Foreground}"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="background" Property="Stroke" Value="{DynamicResource AccentColor}"/>
                                                <Setter TargetName="background" Property="Fill" Value="{DynamicResource ControlBg}"/>
                                                <Setter TargetName="background" Property="StrokeThickness" Value="1.5"/>
                                                <Setter TargetName="background" Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource ModernContextMenu}" 
                                                     Placement="Top" 
                                                     VerticalOffset="-25" 
                                                     StaysOpen="False"
                                                     PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Button}}">

                             <MenuItem IsEnabled="False" FontWeight="SemiBold" Height="48">
                                <MenuItem.Icon>
                                    <Image Source="pack://application:,,,/app.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" Margin="4,0"/>
                                </MenuItem.Icon>
                                <MenuItem.Header>
                                    <TextBlock Text="Totthodhara" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                                </MenuItem.Header>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Clear history" Click="ClearHistory_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE74D;" Width="24" TextAlignment="Center" FontSize="14" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Foreground="{DynamicResource IconColor}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="What's new" Click="WhatsNew_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xEA80;" Width="24" TextAlignment="Center" FontSize="14" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Foreground="{DynamicResource IconColor}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Settings" Click="OpenSettings_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE713;" Width="24" TextAlignment="Center" FontSize="14" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Foreground="{DynamicResource IconColor}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Exit ClipDropPro" Click="ExitApp_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="✕" Width="20" TextAlignment="Center" FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center" Foreground="{DynamicResource IconColor}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
