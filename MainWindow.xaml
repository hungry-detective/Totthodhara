<Window x:Class="ClipDropPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:conv="clr-namespace:ClipDropPro.Converters"
        xmlns:sel="clr-namespace:ClipDropPro.Selectors"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Totthodhara" Height="40" Width="800"
        x:Name="RootWindow"
        Icon="app.png"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        BorderThickness="0" BorderBrush="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        AllowDrop="True" Drop="Window_Drop" PreviewDragOver="Window_PreviewDragOver"
        PreviewMouseDown="Window_PreviewMouseDown" PreviewMouseUp="Window_PreviewMouseUp" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Loaded="MainWindow_Loaded"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True">


    <Window.Resources>
        <sys:Double x:Key="ItemMenuHeight">36</sys:Double>
        <sys:Double x:Key="ItemIconSize">24</sys:Double>
        <sys:Double x:Key="ItemSymbolFontSize">14</sys:Double>
        <sys:Double x:Key="ItemImageIconSize">16</sys:Double>
        <sys:Double x:Key="ImageThumbWidth">24</sys:Double>
        <sys:Double x:Key="ImageThumbHeight">18</sys:Double>
        <sys:Double x:Key="ImageResFontSize">10</sys:Double>
        <sys:Double x:Key="ToolBarBtnSize">28</sys:Double>
        <sys:Double x:Key="ToolBarIconSize">14</sys:Double>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVis" />
        <conv:BooleanToHiddenConverter x:Key="BoolToHidden" />
        <conv:BoolToStarConverter x:Key="BoolToStar" />
        <conv:LeftMonitorsColumnConverter x:Key="LeftMonitorsColumnConverter" />
        <conv:FileToSymbolConverter x:Key="FileToSymbolConverter" />
        <conv:DebugStatusToVisibilityConverter x:Key="DebugStatusToVisibilityConverter" />
        <conv:DebugStatusToBoolConverter x:Key="DebugStatusToBoolConverter" />
        <!-- SearchToggleButton visibility managed in code-behind via UpdateSearchButtonVisibilityForStatus() -->
        <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <conv:PinnedToColorConverter x:Key="PinnedToColorConverter" />
        <conv:PinnedToMenuItemConverter x:Key="PinnedToMenuItemConverter" />
        <conv:SnippetToMenuItemConverter x:Key="SnippetToMenuItemConverter" />
        <conv:StringToHorizontalAlignmentConverter x:Key="StringToAddConverter" />
        <conv:HexToColorConverter x:Key="HexToColorConverter" />
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
        <conv:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibilityConverter" />

        <!-- Content DataTemplates for ItemContentSelector -->
        <DataTemplate x:Key="ImageContentTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="{Binding ThumbnailSource}" Width="{DynamicResource ImageThumbWidth}" Height="{DynamicResource ImageThumbHeight}" Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{Binding ResolutionText}" FontSize="{DynamicResource ImageResFontSize}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}" TextDecorations="None"
                           VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ColorContentTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="14" Height="14" Margin="0,0,6,0" Stroke="{DynamicResource BorderColor}" StrokeThickness="0.5"
                         VerticalAlignment="Center"
                         Fill="{Binding TextContent, Converter={StaticResource HexToColorConverter}}"/>
                <TextBlock Text="{Binding DisplayText}" FontSize="{DynamicResource ItemFontSize}"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" TextDecorations="None"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="UrlContentTemplate">
            <TextBlock Text="{Binding DisplayText}" FontSize="{DynamicResource ItemFontSize}"
                       FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" TextDecorations="None"/>
        </DataTemplate>

        <DataTemplate x:Key="TextContentTemplate">
            <TextBlock Text="{Binding DisplayText}" FontSize="{DynamicResource ItemFontSize}"
                       FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" TextDecorations="None"/>
        </DataTemplate>
        
        <sel:ItemContentSelector x:Key="ItemContentSelector"
                                 TextTemplate="{StaticResource TextContentTemplate}"
                                 ImageTemplate="{StaticResource ImageContentTemplate}"
                                 ColorTemplate="{StaticResource ColorContentTemplate}"
                                 UrlTemplate="{StaticResource UrlContentTemplate}"/>

        <!-- Shared ContextMenu Style for Tray (no DynamicResource - separate visual tree) -->
        <Style x:Key="ModernContextMenu" TargetType="ContextMenu">
            <EventSetter Event="Opened" Handler="ContextMenu_Opened"/>
            <EventSetter Event="Closed" Handler="ContextMenu_Closed"/>
            <Setter Property="Background" Value="{DynamicResource MenuBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="4">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MenuItem Style (no DynamicResource - safe for isolated visual trees like tray ContextMenu) -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid MinHeight="{DynamicResource ItemMenuHeight}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="HoverBorder" Grid.ColumnSpan="2" Background="Transparent" CornerRadius="4" Margin="4,2"/>
                            <ContentPresenter ContentSource="Icon" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0"/>
                            <ContentPresenter ContentSource="Header" Grid.Column="1" Margin="12,6" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverBorder" Property="Background" Value="{DynamicResource ControlBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="Transparent" PreviewMouseLeftButtonDown="RootGrid_PreviewMouseLeftButtonDown">
        <tb:TaskbarIcon x:Name="TrayIcon"
                        Width="0" Height="0"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        ToolTipText="Totthodhara is running"
                        MenuActivation="RightClick"
                        TrayMouseDoubleClick="TaskbarIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Style="{StaticResource ModernContextMenu}">
                    <MenuItem Header="Show Shelf" Click="TaskbarIcon_TrayMouseDoubleClick" />
                    <MenuItem Header="Check updates" Click="CheckForUpdates_Click" />
                    <Separator>
                        <Separator.Template>
                            <ControlTemplate TargetType="Separator">
                                <Border Height="1" Background="{DynamicResource BorderColor}" Margin="8,4" />
                            </ControlTemplate>
                        </Separator.Template>
                    </Separator>
                    <MenuItem Header="Exit" Click="ExitApp_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Border ClipToBounds="True">
            <Border x:Name="CapsuleBorder" 
                    CornerRadius="26" 
                    Background="{DynamicResource AppBackground}"
                    BorderBrush="{DynamicResource BorderColor}" 
                    BorderThickness="0"
                    SnapsToDevicePixels="True"
                    TextOptions.TextFormattingMode="Display"
                    TextOptions.TextRenderingMode="ClearType"
                    RenderOptions.ClearTypeHint="Enabled"
                    ClipToBounds="True">
            <Grid Margin="6,0,6,0" x:Name="ShelfGrid" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Left Monitors (when on left) -->
                    <ColumnDefinition Width="Auto"/> <!-- Scroll Left -->
                    <ColumnDefinition x:Name="ItemsColumn" Width="*"/>    <!-- Middle ScrollArea -->
                    <ColumnDefinition Width="Auto"/> <!-- Scroll Right -->
                    <ColumnDefinition Width="Auto"/> <!-- Search Button -->
                    <ColumnDefinition Width="Auto"/> <!-- MultiPaste Toggle -->
                    <ColumnDefinition Width="Auto"/> <!-- PasteAll Button -->
                    <ColumnDefinition Width="Auto"/> <!-- System Monitor (right) -->
                    <ColumnDefinition Width="Auto"/> <!-- World Clock (right) -->
                    <ColumnDefinition Width="Auto"/> <!-- Plugins -->
                    <ColumnDefinition Width="Auto"/> <!-- More Button -->
                </Grid.ColumnDefinitions>

                <!-- Section dividers — only between major categories -->
                <Rectangle Grid.Column="0" Width="1" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,6,0" Fill="{DynamicResource BorderColor}" Opacity="0.6" IsHitTestVisible="False"
                           Visibility="{Binding ShowLeftMonitors, Converter={StaticResource InvertedBoolToVis}}"/>
                <Rectangle Grid.Column="7" Width="1" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,6,0" Fill="{DynamicResource BorderColor}" Opacity="0.6" IsHitTestVisible="False"
                           Visibility="{Binding ShowSystemMonitor, Converter={StaticResource InvertedBoolToVis}}"/>

                <!-- Left Monitors - speed and hardware when on left -->
                <StackPanel x:Name="LeftMonitorsPanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0"
                            Visibility="{Binding ShowLeftMonitors, Converter={StaticResource BoolToVis}}">
                    <!-- Network Download Left -->
                    <Border Background="{DynamicResource WidgetBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0.5" CornerRadius="8" Padding="4,0" Margin="3,0,3,0" Height="{DynamicResource ToolBarBtnSize}" VerticalAlignment="Center"
                            Visibility="{Binding ShowNetworkOnLeft, Converter={StaticResource BoolToVis}}">
                        <Border.ToolTip>
                            <ToolTip Background="{DynamicResource ToolTipBg}" Foreground="{DynamicResource TextColor}" BorderBrush="{DynamicResource BorderColor}"><TextBlock Text="Download speed"/></ToolTip>
                        </Border.ToolTip>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Viewbox Width="10" Height="14" VerticalAlignment="Center">
                                <Canvas Width="10" Height="14">
                                    <Path Stroke="{DynamicResource IconColor}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Data="M5,1 L5,10.5 M0,9 L5,12 L10,9"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding NetworkDownText}" FontSize="{DynamicResource SysMonitorTextSize}" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" Width="58" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Network Upload Left -->
                    <Border Background="{DynamicResource WidgetBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0.5" CornerRadius="8" Padding="4,0" Margin="3,0,3,0" Height="{DynamicResource ToolBarBtnSize}" VerticalAlignment="Center"
                            Visibility="{Binding ShowNetworkOnLeft, Converter={StaticResource BoolToVis}}">
                        <Border.ToolTip>
                            <ToolTip Background="{DynamicResource ToolTipBg}" Foreground="{DynamicResource TextColor}" BorderBrush="{DynamicResource BorderColor}"><TextBlock Text="Upload speed"/></ToolTip>
                        </Border.ToolTip>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Viewbox Width="10" Height="14" VerticalAlignment="Center">
                                <Canvas Width="10" Height="14">
                                    <Path Stroke="{DynamicResource IconColor}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Data="M5,13 L5,3.5 M0,5 L5,2 L10,5"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding NetworkUpText}" FontSize="{DynamicResource SysMonitorTextSize}" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" Width="58" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- CPU Left -->
                    <Border Background="{DynamicResource WidgetBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0.5" CornerRadius="8" Padding="6,0" Margin="3,0,3,0" Height="{DynamicResource ToolBarBtnSize}" VerticalAlignment="Center"
                            Visibility="{Binding ShowHardwareOnLeft, Converter={StaticResource BoolToVis}}">
                        <Border.ToolTip>
                            <ToolTip Background="{DynamicResource ToolTipBg}" Foreground="{DynamicResource TextColor}" BorderBrush="{DynamicResource BorderColor}"><TextBlock Text="CPU Usage"/></ToolTip>
                        </Border.ToolTip>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="{DynamicResource SysMonitorCanvasSize}" Height="{DynamicResource SysMonitorCanvasSize}" Margin="0,0,1,0" VerticalAlignment="Center">
                                <Canvas Width="14" Height="14">
                                    <Path Stroke="{DynamicResource IconColor}" StrokeThickness="1.2" Fill="Transparent" Data="M2,2 L12,2 L12,12 L2,12 Z"/>
                                    <Path Stroke="{DynamicResource IconColor}" StrokeThickness="0.8" Fill="Transparent" Data="M5,5 L9,5 L9,9 L5,9 Z"/>
                                    <Line X1="4" Y1="0" X2="4" Y2="2" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                    <Line X1="7" Y1="0" X2="7" Y2="2" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                    <Line X1="10" Y1="0" X2="10" Y2="2" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                    <Line X1="4" Y1="12" X2="4" Y2="14" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                    <Line X1="7" Y1="12" X2="7" Y2="14" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                    <Line X1="10" Y1="12" X2="10" Y2="14" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                    <Line X1="0" Y1="4" X2="2" Y2="4" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                    <Line X1="0" Y1="7" X2="2" Y2="7" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                    <Line X1="0" Y1="10" X2="2" Y2="10" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                    <Line X1="12" Y1="4" X2="14" Y2="4" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                    <Line X1="12" Y1="7" X2="14" Y2="7" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                    <Line X1="12" Y1="10" X2="14" Y2="10" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                    <Ellipse Canvas.Left="2.5" Canvas.Top="2.5" Width="1.5" Height="1.5" Fill="{DynamicResource IconColor}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:00}%}" FontSize="{DynamicResource SysMonitorTextSize}" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" MinWidth="30" TextAlignment="Right"/>
                        </StackPanel>
                    </Border>
                    <!-- Memory Left -->
                    <Border Background="{DynamicResource WidgetBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0.5" CornerRadius="8" Padding="6,0" Margin="3,0,3,0" Height="{DynamicResource ToolBarBtnSize}" VerticalAlignment="Center"
                            Visibility="{Binding ShowHardwareOnLeft, Converter={StaticResource BoolToVis}}">
                        <Border.ToolTip>
                            <ToolTip Background="{DynamicResource ToolTipBg}" Foreground="{DynamicResource TextColor}" BorderBrush="{DynamicResource BorderColor}"><TextBlock Text="Memory Usage"/></ToolTip>
                        </Border.ToolTip>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="{DynamicResource SysMonitorCanvasSize}" Height="{DynamicResource SysMonitorCanvasSize}" Margin="0,0,1,0" VerticalAlignment="Center">
                                <Canvas Width="14" Height="14">
                                <Path Stroke="{DynamicResource IconColor}" StrokeThickness="1.2" Fill="Transparent" Data="M1,3 L13,3 L13,11 L1,11 Z"/>
                                <Line X1="3" Y1="1" X2="3" Y2="3" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                <Line X1="5" Y1="1" X2="5" Y2="3" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                <Line X1="7" Y1="1" X2="7" Y2="3" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                <Line X1="9" Y1="1" X2="9" Y2="3" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                <Line X1="11" Y1="1" X2="11" Y2="3" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                <Line X1="3" Y1="11" X2="3" Y2="13" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                <Line X1="5" Y1="11" X2="5" Y2="13" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                <Line X1="7" Y1="11" X2="7" Y2="13" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                <Line X1="9" Y1="11" X2="9" Y2="13" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                <Line X1="11" Y1="11" X2="11" Y2="13" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                <Line X1="2" Y1="7" X2="12" Y2="7" Stroke="{DynamicResource IconColor}" StrokeThickness="0.6"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding MemoryUsage, StringFormat={}{0:00}%}" FontSize="{DynamicResource SysMonitorTextSize}" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" MinWidth="30" TextAlignment="Right"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Scroll Left Button -->
                <Button Grid.Column="1" Click="ScrollLeft_Click" 
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource IconColor}" 
                        Margin="1,0" VerticalAlignment="Center" Width="{DynamicResource ToolBarBtnSize}" Height="{DynamicResource ToolBarBtnSize}"
                        Visibility="{Binding HideClipboard, Converter={StaticResource InvertedBoolToVis}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="background" CornerRadius="8" Background="Transparent" Padding="4">
                                            <ui:SymbolIcon Symbol="ChevronLeft24" 
                                                           FontSize="{DynamicResource ToolBarIconSize}"
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center" 
                                                           Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="background" Property="Background" Value="{DynamicResource ControlBg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Middle: Horizontal ScrollViewer + ItemsControl -->
                <Border Grid.Column="2" Margin="1,0" Background="Transparent"
                        Visibility="{Binding HideClipboard, Converter={StaticResource BoolToHidden}}">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0.0" />
                            <GradientStop Color="Black" Offset="0.02" /> 
                            <GradientStop Color="Black" Offset="0.98" />
                            <GradientStop Color="Transparent" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                    <ScrollViewer x:Name="ShelfScrollViewer"
                              Background="Transparent"
                              HorizontalScrollBarVisibility="Hidden" 
                              VerticalScrollBarVisibility="Disabled"
                              PanningMode="HorizontalOnly"
                              HorizontalAlignment="{Binding Alignment, Converter={StaticResource StringToAddConverter}}"
                              PreviewMouseWheel="ShelfScrollViewer_PreviewMouseWheel">
                    <ItemsControl x:Name="ItemsHost"
                                  Background="Transparent"
                                  ItemsSource="{Binding ClipboardItems}"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.ScrollUnit="Item">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal" VirtualizationMode="Recycling"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="{DynamicResource ItemCircleCorner}" Height="{DynamicResource ItemCardHeight}" Margin="2,0" Padding="{DynamicResource ItemPadding}" MinWidth="48" MaxWidth="160" VerticalAlignment="Center" SnapsToDevicePixels="True"
                                    BorderThickness="0.7"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource CardItemBg}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Cursor" Value="Hand"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsRemoving}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="0" Duration="0:0:0.35">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseIn"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="0" Duration="0:0:0.35">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseIn"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SelectedItemGradient}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </DataTrigger>
                                            
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.ContextMenu>
                                    <!-- FIX: Placement=Top so menu appears above items, not behind them -->
                                    <ContextMenu Style="{StaticResource ModernContextMenu}" StaysOpen="False" Placement="Bottom" VerticalOffset="4">
                                        <MenuItem Header="{Binding IsPinned, Converter={StaticResource PinnedToMenuItemConverter}}"
                                                  Command="{Binding PlacementTarget.Tag.TogglePinCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Pin24" Filled="True" FontSize="12" Foreground="{DynamicResource TextColor}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{Binding IsSnippet, Converter={StaticResource SnippetToMenuItemConverter}}"
                                                  Command="{Binding PlacementTarget.Tag.ToggleSnippetCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Star24" Filled="True" FontSize="12" Foreground="{DynamicResource TextColor}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Delete"
                                                  Command="{Binding PlacementTarget.Tag.DeleteItemCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="12" Foreground="{DynamicResource TextColor}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                
                                 <Grid VerticalAlignment="Center">
                                     <!-- Separator line before first unpinned item -->
                                    <Rectangle Width="1" HorizontalAlignment="Left" Fill="{DynamicResource BorderColor}" Opacity="0.6"
                                               IsHitTestVisible="False" Margin="-4,6,0,6"
                                               Visibility="{Binding IsFirstUnpinned, Converter={StaticResource BoolToVis}}"/>
                                       <Grid PreviewMouseMove="Item_PreviewMouseMove" ToolTipService.InitialShowDelay="100" ToolTipService.ShowDuration="15000" ToolTipService.ShowOnDisabled="False">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                    <Grid.ToolTip>
                                         <ToolTip Background="{DynamicResource ToolTipBg}" Foreground="{DynamicResource TextColor}" BorderThickness="0" Padding="5" Placement="Top" VerticalOffset="-8">
                                            <StackPanel MaxWidth="300">
                                                <!-- Image ToolTip -->
                                                <Image Source="{Binding ThumbnailSource}" MaxHeight="200" Stretch="Uniform" 
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}"/>
                                                
                                                <!-- Video ToolTip with Play Overlay -->
                                                <Grid Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}" MaxHeight="200">
                                                    <Image Source="{Binding ThumbnailSource}" Stretch="Uniform" 
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <Path Data="M 0,0 L 20,10 L 0,20 Z" Fill="#CCFFFFFF" Stretch="Uniform" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>

                                                <!-- PDF Info Card -->
                                                <StackPanel Visibility="{Binding IsPdf, Converter={StaticResource BoolToVis}}" MinWidth="200" Margin="10">
                                                    <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="{DynamicResource IconColor}"/>
                                                    <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextColor}" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                                    <TextBlock Text="PDF Document" Foreground="{DynamicResource TextColor}" Opacity="0.6" FontSize="10" HorizontalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Audio Info Card -->
                                                <StackPanel Visibility="{Binding IsAudio, Converter={StaticResource BoolToVis}}" MinWidth="200" Margin="10">
                                                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="{DynamicResource IconColor}"/>
                                                    <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextColor}" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                                    <TextBlock Text="Audio File" Foreground="{DynamicResource TextColor}" Opacity="0.6" FontSize="10" HorizontalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Text ToolTip -->
                                                <TextBlock Text="{Binding TextContent}" Foreground="{DynamicResource TextColor}" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </ToolTip>
                                    </Grid.ToolTip>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- Column 0: Pill index -->
                                        <ColumnDefinition Width="Auto"/> <!-- Column 1: Icon -->
                                        <ColumnDefinition Width="*"/>    <!-- Column 2: Content -->
                                        <ColumnDefinition Width="Auto"/> <!-- Column 3: URL Open -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Index number (plain text, no circle highlight) -->
                                    <Grid Grid.Column="0" Margin="6,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayIndex}"
                                                   FontSize="{DynamicResource ItemIndexFontSize}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextColor}"
                                                   Opacity="1.0"
                                                   TextDecorations="None"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Icon Column -->
                                    <Border Grid.Column="1" Width="{DynamicResource ItemIconSize}" Height="{DynamicResource ItemIconSize}" CornerRadius="4" Margin="0,0,4,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="{Binding HasIcon, Converter={StaticResource BoolToVis}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <ui:SymbolIcon Symbol="{Binding ., Converter={StaticResource FileToSymbolConverter}}" FontSize="{DynamicResource ItemSymbolFontSize}" Foreground="{DynamicResource IconColor}"
                                                           Visibility="{Binding IsUrl, Converter={StaticResource InvertedBoolToVis}}"/>
                                            <Image Source="{Binding IconSource}" Width="{DynamicResource ItemImageIconSize}" Height="{DynamicResource ItemImageIconSize}" Stretch="UniformToFill"
                                                   Visibility="{Binding IsUrl, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Content Column (dynamic per type via ItemContentSelector) -->
                                    <ContentPresenter Grid.Column="2"
                                                      Content="{Binding}"
                                                      ContentTemplateSelector="{StaticResource ItemContentSelector}"
                                                      VerticalAlignment="Center" Margin="0,0,6,0"/>

<!-- URL Open Button (Column 3) -->
                                     <Button Grid.Column="3" 
                                             Click="OpenUrl_Click"
                                             PreviewMouseDown="OpenUrl_PreviewMouseDown"
                                             Background="Transparent" BorderThickness="0"
                                             Padding="2,0" Margin="2,0,0,0"
                                             VerticalAlignment="Center"
                                             FocusVisualStyle="{x:Null}"
                                             Visibility="{Binding IsUrl, Converter={StaticResource BoolToVis}}"
                                             ToolTip="Open URL">
                                        <ui:SymbolIcon Symbol="Open24" FontSize="14" Foreground="{DynamicResource IconColor}"/>
                                    </Button>
                                </Grid>
                                    <!-- Pin Overlay (top-right of item border, renders on top of content) -->
                                    <ui:SymbolIcon Symbol="Pin24" Filled="True" FontSize="14"
                                                       HorizontalAlignment="Right" VerticalAlignment="Top"
                                                       Margin="0,-5,-2,0"
                                                       Foreground="{DynamicResource AccentColor}"
                                                       IsHitTestVisible="False"
                                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"/>
                                    <!-- Snippet Overlay (top-left of item border, renders on top of content) -->
                                    <ui:SymbolIcon Symbol="Star24" Filled="True" FontSize="9"
                                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                                       Margin="-3,-3,0,0"
                                                       Foreground="#FFD700"
                                                       IsHitTestVisible="False"
                                                        Visibility="{Binding IsSnippet, Converter={StaticResource BoolToVis}}"/>
                                     <!-- Dynamic Status Badge (text only) -->
                                     <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextColor}" FontSize="{DynamicResource ItemFontSize}" FontWeight="Bold"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding StatusText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                             </Grid>
                            </Border>
                        </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Scroll Right Button -->
                <Button Grid.Column="3" Click="ScrollRight_Click" 
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource IconColor}" 
                        Margin="1,0" VerticalAlignment="Center" Width="{DynamicResource ToolBarBtnSize}" Height="{DynamicResource ToolBarBtnSize}"
                        Visibility="{Binding HideClipboard, Converter={StaticResource InvertedBoolToVis}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="background" CornerRadius="8" Background="Transparent" Padding="4">
                                            <ui:SymbolIcon Symbol="ChevronRight24" 
                                                           FontSize="{DynamicResource ToolBarIconSize}"
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center" 
                                                           Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="background" Property="Background" Value="{DynamicResource ControlBg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Status Toast overlay — Popup centered above the shelf with animation -->
                <Popup x:Name="StatusToastPopup"
                       AllowsTransparency="True" Placement="Top"
                       VerticalOffset="-10" StaysOpen="False" PopupAnimation="Slide">
                    <Border x:Name="StatusToastBorder" Background="{DynamicResource WindowBg}" CornerRadius="12" Padding="16,8"
                            BorderBrush="{DynamicResource AccentColor}" BorderThickness="1"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                <TranslateTransform Y="0"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <TextBlock x:Name="StatusToastText" Text="{Binding DebugStatus}" Foreground="{DynamicResource AccentColor}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Border>
                </Popup>

                <!-- Search Toggle Button / Inline Search Box -->
                <Button Grid.Column="4" x:Name="SearchToggleButton"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource IconColor}"
                        Margin="1,0" VerticalAlignment="Center"
                        Width="{DynamicResource ToolBarBtnSize}" Height="{DynamicResource ToolBarBtnSize}"
                        Click="SearchToggleButton_Click"
                        FocusVisualStyle="{x:Null}"
                        Visibility="{Binding HideClipboard, Converter={StaticResource InvertedBoolToVis}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="background" CornerRadius="8" Background="Transparent" Padding="4">
                                            <ui:SymbolIcon Symbol="Search24" 
                                                           FontSize="{DynamicResource ToolBarIconSize}"
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center" 
                                                           Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="background" Property="Background" Value="{DynamicResource ControlBg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- MultiPaste Toggle Button -->
                <ToggleButton Grid.Column="5" x:Name="MultiPasteToggleButton"
                              Background="Transparent" BorderThickness="0" Foreground="{DynamicResource IconColor}"
                              Margin="1,0" VerticalAlignment="Center"
                              Width="{DynamicResource ToolBarBtnSize}" Height="{DynamicResource ToolBarBtnSize}"
                              FocusVisualStyle="{x:Null}"
                              IsChecked="{Binding IsMultiPasteMode}"
                              Visibility="{Binding HideClipboard, Converter={StaticResource InvertedBoolToVis}}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="background" CornerRadius="8" Background="Transparent" Width="{DynamicResource ToolBarBtnSize}" Height="{DynamicResource ToolBarBtnSize}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="background" Property="Background" Value="{DynamicResource AccentColor}"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsChecked" Value="False"/>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="background" Property="Background" Value="{DynamicResource ControlBg}"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                    <ui:SymbolIcon Symbol="Copy24" 
                                   FontSize="{DynamicResource ToolBarIconSize}"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center" 
                                   Foreground="{DynamicResource IconColor}"/>
                </ToggleButton>

                <!-- Paste All Button (visible when items selected for multi-paste) -->
                <Button Grid.Column="6" x:Name="PasteAllButton"
                        Margin="1,0" VerticalAlignment="Center" Padding="0"
                        Height="{DynamicResource ToolBarBtnSize}"
                        HorizontalContentAlignment="Center"
                        Click="PasteAllButton_Click"
                        FocusVisualStyle="{x:Null}"
                        ToolTip="Paste all selected items">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="background" CornerRadius="8" Background="{DynamicResource AccentColor}" Padding="12,0" Height="{DynamicResource ToolBarBtnSize}" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="background" Property="Background" Value="{DynamicResource AccentColorDim}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedItems}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HideClipboard}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="Paste All" Foreground="White" FontSize="{DynamicResource ItemSmallFontSize}" FontWeight="SemiBold"/>
                </Button>

                <!-- System Monitor Widgets -->
<Border Grid.Column="7" VerticalAlignment="Center" Margin="1,0"
                        Visibility="{Binding ShowSystemMonitor, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Network Download -->
                        <Border Background="{DynamicResource WidgetBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0.5" CornerRadius="8" Padding="4,0" Margin="3,0,3,0" Height="{DynamicResource ToolBarBtnSize}" VerticalAlignment="Center"
                                 Visibility="{Binding ShowNetworkOnRight, Converter={StaticResource BoolToVis}}">
                                <Border.ToolTip>
                                    <ToolTip Background="{DynamicResource ToolTipBg}" Foreground="{DynamicResource TextColor}" BorderBrush="{DynamicResource BorderColor}"><TextBlock Text="Download speed"/></ToolTip>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Viewbox Width="10" Height="14" VerticalAlignment="Center">
                                    <Canvas Width="10" Height="14">
                                        <Path Stroke="{DynamicResource IconColor}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Data="M5,1 L5,11 M1,8 L5,12 L9,8"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{Binding NetworkDownText}" FontSize="{DynamicResource SysMonitorTextSize}" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" Width="58" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Network Upload -->
                        <Border Background="{DynamicResource WidgetBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0.5" CornerRadius="8" Padding="4,0" Margin="3,0,3,0" Height="{DynamicResource ToolBarBtnSize}" VerticalAlignment="Center"
                                 Visibility="{Binding ShowNetworkOnRight, Converter={StaticResource BoolToVis}}">
                            <Border.ToolTip>
                                <ToolTip Background="{DynamicResource ToolTipBg}" Foreground="{DynamicResource TextColor}" BorderBrush="{DynamicResource BorderColor}"><TextBlock Text="Upload speed"/></ToolTip>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Viewbox Width="10" Height="14" VerticalAlignment="Center">
                                    <Canvas Width="10" Height="14">
                                        <Path Stroke="{DynamicResource IconColor}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Data="M5,13 L5,3 M1,6 L5,2 L9,6"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{Binding NetworkUpText}" FontSize="{DynamicResource SysMonitorTextSize}" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" Width="58" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- CPU - chip icon with pins -->
                        <Border Background="{DynamicResource WidgetBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0.5" CornerRadius="8" Padding="6,0" Margin="3,0,3,0" Height="{DynamicResource ToolBarBtnSize}" VerticalAlignment="Center"
                                Visibility="{Binding ShowHardwareOnRight, Converter={StaticResource BoolToVis}}">
                            <Border.ToolTip>
                                <ToolTip Background="{DynamicResource ToolTipBg}" Foreground="{DynamicResource TextColor}" BorderBrush="{DynamicResource BorderColor}"><TextBlock Text="CPU Usage"/></ToolTip>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="{DynamicResource SysMonitorCanvasSize}" Height="{DynamicResource SysMonitorCanvasSize}" Margin="0,0,1,0" VerticalAlignment="Center">
                                    <Canvas Width="14" Height="14">
                                        <Path Stroke="{DynamicResource IconColor}" StrokeThickness="1.2" Fill="Transparent" Data="M2,2 L12,2 L12,12 L2,12 Z"/>
                                        <Path Stroke="{DynamicResource IconColor}" StrokeThickness="0.8" Fill="Transparent" Data="M5,5 L9,5 L9,9 L5,9 Z"/>
                                        <Line X1="4" Y1="0" X2="4" Y2="2" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                        <Line X1="7" Y1="0" X2="7" Y2="2" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                        <Line X1="10" Y1="0" X2="10" Y2="2" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                        <Line X1="4" Y1="12" X2="4" Y2="14" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                        <Line X1="7" Y1="12" X2="7" Y2="14" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                        <Line X1="10" Y1="12" X2="10" Y2="14" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                        <Line X1="0" Y1="4" X2="2" Y2="4" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                        <Line X1="0" Y1="7" X2="2" Y2="7" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                        <Line X1="0" Y1="10" X2="2" Y2="10" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                        <Line X1="12" Y1="4" X2="14" Y2="4" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                        <Line X1="12" Y1="7" X2="14" Y2="7" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                        <Line X1="12" Y1="10" X2="14" Y2="10" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                        <Ellipse Canvas.Left="2.5" Canvas.Top="2.5" Width="1.5" Height="1.5" Fill="{DynamicResource IconColor}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:00}%}" FontSize="{DynamicResource SysMonitorTextSize}" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" MinWidth="30" TextAlignment="Right"/>
                            </StackPanel>
                        </Border>
                        <!-- Memory - horizontal RAM stick -->
                        <Border Background="{DynamicResource WidgetBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0.5" CornerRadius="8" Padding="6,0" Margin="3,0,3,0" Height="{DynamicResource ToolBarBtnSize}" VerticalAlignment="Center"
                                Visibility="{Binding ShowHardwareOnRight, Converter={StaticResource BoolToVis}}">
                            <Border.ToolTip>
                                <ToolTip Background="{DynamicResource ToolTipBg}" Foreground="{DynamicResource TextColor}" BorderBrush="{DynamicResource BorderColor}"><TextBlock Text="Memory Usage"/></ToolTip>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="{DynamicResource SysMonitorCanvasSize}" Height="{DynamicResource SysMonitorCanvasSize}" Margin="0,0,1,0" VerticalAlignment="Center">
                                    <Canvas Width="14" Height="14">
                                    <Path Stroke="{DynamicResource IconColor}" StrokeThickness="1.2" Fill="Transparent" Data="M1,3 L13,3 L13,11 L1,11 Z"/>
                                    <Line X1="3" Y1="1" X2="3" Y2="3" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                    <Line X1="5" Y1="1" X2="5" Y2="3" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                    <Line X1="7" Y1="1" X2="7" Y2="3" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                    <Line X1="9" Y1="1" X2="9" Y2="3" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                    <Line X1="11" Y1="1" X2="11" Y2="3" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                    <Line X1="3" Y1="11" X2="3" Y2="13" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                    <Line X1="5" Y1="11" X2="5" Y2="13" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                    <Line X1="7" Y1="11" X2="7" Y2="13" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                    <Line X1="9" Y1="11" X2="9" Y2="13" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                    <Line X1="11" Y1="11" X2="11" Y2="13" Stroke="{DynamicResource IconColor}" StrokeThickness="1"/>
                                    <Line X1="2" Y1="7" X2="12" Y2="7" Stroke="{DynamicResource IconColor}" StrokeThickness="0.6"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{Binding MemoryUsage, StringFormat={}{0:00}%}" FontSize="{DynamicResource SysMonitorTextSize}" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" MinWidth="30" TextAlignment="Right"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- World Clock (pinned clocks on top) -->
<Border Grid.Column="8" VerticalAlignment="Center" Margin="1,0"
                        Visibility="{Binding ShowWorldClock, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding PinnedWorldClocks}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0.5" CornerRadius="8" Margin="3,0,3,0" Height="{DynamicResource ToolBarBtnSize}" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Padding" Value="6,0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.CompactClock, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="Padding" Value="4,0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ToolTip>
                                        <ToolTip Background="{DynamicResource ToolTipBg}" Foreground="{DynamicResource TextColor}" BorderBrush="{DynamicResource BorderColor}">
                                            <TextBlock Text="{Binding ToolTip}" FontSize="12" TextWrapping="Wrap" MaxWidth="260"/>
                                        </ToolTip>
                                    </Border.ToolTip>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE121;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource SysMonitorTextSize}" Foreground="{DynamicResource IconColor}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="9" Foreground="{DynamicResource IconColor}" VerticalAlignment="Center" Margin="0,0,3,0" FontWeight="Bold" Opacity="0.7"/>
                                        <TextBlock Text="{Binding Text}" FontSize="{DynamicResource SysMonitorTextSize}" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" FontWeight="SemiBold" MinWidth="58" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Plugin Widgets -->
                <Border Grid.Column="9" VerticalAlignment="Center" Margin="2,0"
                        Visibility="{Binding ShowPlugins, Converter={StaticResource BoolToVis}}">
                    <StackPanel x:Name="PluginContainer" Orientation="Horizontal" VerticalAlignment="Center"/>
                </Border>

                <!-- Right: More Button with Context Menu (shows app icon) -->
                <Button Grid.Column="10"
                        x:Name="MoreButton"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource IconColor}"
                        Margin="1,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Width="{DynamicResource ToolBarBtnSize}" Height="{DynamicResource ToolBarBtnSize}"
                        Click="MoreButton_Click"
                        FocusVisualStyle="{x:Null}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="background" CornerRadius="8" Background="Transparent" Padding="4">
                                            <ui:SymbolIcon Symbol="Settings24" 
                                                           FontSize="{DynamicResource ToolBarIconSize}"
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center" 
                                                           Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="background" Property="Background" Value="{DynamicResource ControlBg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.ContextMenu>
                        <!-- FIX: Placement=Top so menu appears above the bar, not behind items -->
                        <ContextMenu Style="{StaticResource ModernContextMenu}" 
                                     Placement="Top" 
                                     VerticalOffset="-4"
                                     StaysOpen="False">

                             <MenuItem IsEnabled="False" FontWeight="SemiBold" Height="48">
                                <MenuItem.Icon>
                                    <Border Width="32" Height="32" ClipToBounds="True" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="pack://application:,,,/app.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
                                    </Border>
                                </MenuItem.Icon>
                                <MenuItem.Header>
                                    <TextBlock Text="Totthodhara" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                                </MenuItem.Header>
                            </MenuItem>
